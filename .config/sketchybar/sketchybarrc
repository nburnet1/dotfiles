#!/bin/bash

# SketchyBar configuration with AeroSpace integration
# A clean, minimal, and functional status bar

PLUGIN_DIR="$CONFIG_DIR/plugins"
ITEM_DIR="$CONFIG_DIR/items"

# Source colors (generated from wallpaper via pywal)
source "$CONFIG_DIR/colors.sh"

##### Bar Appearance #####
sketchybar --bar \
  position=top \
  height=32 \
  blur_radius=30 \
  color=$BAR_COLOR \
  border_width=0 \
  margin=0 \
  y_offset=0 \
  corner_radius=0 \
  padding_left=8 \
  padding_right=8 \
  notch_width=0 \
  topmost=off \
  shadow=off

##### Default Item Settings #####
default=(
  padding_left=6
  padding_right=6
  icon.font="FiraCode Nerd Font Mono:Regular:14.0"
  label.font="FiraCode Nerd Font Mono:Regular:13.0"
  icon.color=$ICON_COLOR
  label.color=$LABEL_COLOR
  icon.padding_left=4
  icon.padding_right=4
  label.padding_left=4
  label.padding_right=4
  background.height=26
  background.corner_radius=8
)
sketchybar --default "${default[@]}"

##### Register AeroSpace Event #####
sketchybar --add event aerospace_workspace_change

##### Left Side Items #####

# Front App with native icon (first item)
sketchybar --add item front_app left \
           --set front_app \
                 icon.drawing=off \
                 background.image.scale=0.65 \
                 background.image.drawing=on \
                 background.drawing=on \
                 background.color=0x00000000 \
                 background.padding_right=5 \
                 label.font="FiraCode Nerd Font Mono:Regular:13.0" \
                 label.color=$LABEL_COLOR \
                 label.padding_left=25 \
                 label.width=120 \
                 label.max_chars=12 \
                 script="$PLUGIN_DIR/front_app.sh" \
           --subscribe front_app front_app_switched

# Chevron separator
sketchybar --add item chevron left \
           --set chevron \
                 icon="󰅂" \
                 icon.font="FiraCode Nerd Font Mono:Regular:12.0" \
                 icon.color=$SUBTLE_COLOR \
                 label.drawing=off \
                 padding_left=4 \
                 padding_right=4

# AeroSpace Workspaces
source "$ITEM_DIR/aerospace.sh"

##### Center Items #####

# Media Player (now playing)
sketchybar --add item media center \
           --set media \
                 icon="󰎆" \
                 icon.color=$ACCENT_COLOR \
                 label.max_chars=40 \
                 scroll_texts=on \
                 updates=on \
                 script="$PLUGIN_DIR/media.sh" \
           --subscribe media media_change

##### Right Side Items #####

# Date and Time
sketchybar --add item clock right \
           --set clock \
                 icon.drawing=off \
                 update_freq=30 \
                 script="$PLUGIN_DIR/clock.sh"

# WiFi Status
sketchybar --add item wifi right \
           --set wifi \
                 icon="󰤨" \
                 icon.color=$ACCENT_COLOR \
                 icon.padding_right=0 \
                 label.drawing=off \
                 update_freq=30 \
                 script="$PLUGIN_DIR/wifi.sh" \
                 click_script="open 'x-apple.systempreferences:com.apple.preference.network'"

# Volume
sketchybar --add item volume right \
           --set volume \
                 icon.color=$ACCENT_COLOR \
                 script="$PLUGIN_DIR/volume.sh" \
           --subscribe volume volume_change

# Battery
sketchybar --add item battery right \
           --set battery \
                 icon.color=$ACCENT_COLOR \
                 update_freq=120 \
                 script="$PLUGIN_DIR/battery.sh" \
           --subscribe battery system_woke power_source_change

# RAM Usage
sketchybar --add item ram right \
           --set ram \
                 icon="󰍛" \
                 icon.color=$ACCENT_COLOR \
                 update_freq=5 \
                 script="$PLUGIN_DIR/ram.sh"

# Gap before CPU card
sketchybar --add item gap1 right \
           --set gap1 \
                 width=4 \
                 icon.drawing=off \
                 label.drawing=off \
                 background.drawing=off

# CPU Card - FelixKratz style (label + percent + graph)
source "$ITEM_DIR/cpu.sh"

# Gap before Network card
sketchybar --add item gap2 right \
           --set gap2 \
                 width=4 \
                 icon.drawing=off \
                 label.drawing=off \
                 background.drawing=off

# Network Card - FelixKratz style (label + speed + dual graphs)
source "$ITEM_DIR/network.sh"

##### Bracket Groups #####

# Group left items
sketchybar --add bracket workspaces '/space\..*/' \
           --set workspaces \
                 background.color=$BRACKET_COLOR \
                 background.corner_radius=8 \
                 background.height=26 \
                 background.drawing=on

# Group right status items
sketchybar --add bracket status battery volume wifi clock ram \
           --set status \
                 background.color=$BRACKET_COLOR \
                 background.corner_radius=8 \
                 background.height=26 \
                 background.drawing=on

# Group CPU card items
sketchybar --add bracket cpu_card cpu.top cpu.percent cpu.sys \
           --set cpu_card \
                 background.color=$BRACKET_COLOR \
                 background.corner_radius=8 \
                 background.height=26 \
                 background.drawing=on

# Group Network card items  
sketchybar --add bracket net_card net.top net.speed net.down net.up \
           --set net_card \
                 background.color=$BRACKET_COLOR \
                 background.corner_radius=8 \
                 background.height=26 \
                 background.drawing=on

##### Force all scripts to run the first time #####
sketchybar --update
